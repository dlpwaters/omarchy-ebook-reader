SUPPORTED = {"epub", "azw", "azw3", "mobi", "prc", "pdf", "fb2", "fbz", "htmlz", "txt", "txtz", "rtf"}
CONVERTIBLE = SUPPORTED - {"epub", "pdf"}
FORMAT_PRIORITY = ["epub", "azw3", "mobi", "azw", "prc", "fb2", "fbz", "htmlz", "rtf", "txtz", "txt", "pdf"]
THEMES = {"paper", "sepia", "night", "slate"}
FONTS = {"serif", "sans", "publisher"}
FLOWS = {"paginated", "scrolled"}


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def atomic_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + f".tmp-{os.getpid()}")
    temp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(temp, path)


def read_json(path: Path, fallback: object) -> object:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value
    except (OSError, ValueError, TypeError):
        return fallback


def contains_supported_book(folder: Path) -> bool:
    if not folder.is_dir():
        return False
    for _, directories, files in os.walk(folder):
        directories[:] = [name for name in directories if not name.startswith(".")]
        if any(Path(name).suffix.lower().lstrip(".") in SUPPORTED for name in files):
            return True
    return False


def default_library() -> str:
    personal_books = Path.home() / "Books"
    if contains_supported_book(personal_books):
        return str(personal_books)
    if contains_supported_book(STARTER_LIBRARY_DIR):
        return str(STARTER_LIBRARY_DIR)
    return str(personal_books)


def default_settings() -> dict:
    return {
        "libraryFolder": default_library(),
        "fontSize": 20,
        "fontFamily": "serif",
        "lineHeight": 1.65,
        "pageWidth": 760,
        "theme": "paper",
        "flow": "paginated",
        "pageTurn": True,
        "showClock": False,
        "sort": "recent",
    }


def settings() -> dict:
    result = default_settings()
    saved = read_json(SETTINGS_FILE, {})
    if isinstance(saved, dict):
        result.update(saved)
    return validate_settings(result)


def boolean_setting(value, fallback: bool) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"true", "1", "yes", "on"}:
            return True
        if normalized in {"false", "0", "no", "off"}:
            return False
    if isinstance(value, (int, float)) and value in {0, 1}:
        return bool(value)
    return fallback


def validate_settings(value: dict) -> dict:
    result = default_settings()
    result.update(value)
    folder = Path(os.path.expandvars(os.path.expanduser(str(result.get("libraryFolder", ""))))).resolve()
    result["libraryFolder"] = str(folder)
    result["fontSize"] = max(14, min(36, int(result.get("fontSize", 20))))
    result["lineHeight"] = max(1.25, min(2.2, round(float(result.get("lineHeight", 1.65)), 2)))
    result["pageWidth"] = max(520, min(1100, int(result.get("pageWidth", 760))))
    result["theme"] = result.get("theme") if result.get("theme") in THEMES else "paper"
    result["fontFamily"] = result.get("fontFamily") if result.get("fontFamily") in FONTS else "serif"
    result["flow"] = result.get("flow") if result.get("flow") in FLOWS else "paginated"
    result["pageTurn"] = boolean_setting(result.get("pageTurn"), True)
    result["showClock"] = boolean_setting(result.get("showClock"), False)
    result["sort"] = result.get("sort") if result.get("sort") in {"recent", "title", "author", "added"} else "recent"
    return result


def save_settings(changes: dict) -> dict:
    current = settings()
    current.update(changes)
    current = validate_settings(current)
    atomic_json(SETTINGS_FILE, current)
    return current


def text_of(node: ET.Element | None, default: str = "") -> str:
    if node is None:
        return default
    return " ".join("".join(node.itertext()).split()) or default


def parse_opf_bytes(data: bytes) -> dict:
    if len(data) > MAX_EPUB_PACKAGE_XML_BYTES:
        return {}
    try:
        root = ET.fromstring(data)
    except ET.ParseError:
        return {}
    title = text_of(root.find(".//{http://purl.org/dc/elements/1.1/}title"))
    creators = [text_of(x) for x in root.findall(".//{http://purl.org/dc/elements/1.1/}creator") if text_of(x)]
    language = text_of(root.find(".//{http://purl.org/dc/elements/1.1/}language"))
    description = text_of(root.find(".//{http://purl.org/dc/elements/1.1/}description"))
    return {"title": title, "authors": creators, "language": language, "description": description}


def safe_epub_member_name(value: object) -> str:
    if not isinstance(value, str) or not value or "\x00" in value or "\\" in value:
        return ""
    if value.startswith("/") or any(part in {"", ".", ".."} for part in value.split("/")):
        return ""
    return value


def bounded_zip_member(archive: zipfile.ZipFile, name: str, limit: int) -> bytes | None:
    """Read one non-encrypted ZIP member without trusting its compressed payload."""
    safe_name = safe_epub_member_name(name)
    if not safe_name:
        return None
    try:
        info = archive.getinfo(safe_name)
    except KeyError:
        return None
    if info.is_dir() or info.flag_bits & 0x1 or info.file_size > limit:
        return None
    with archive.open(info, "r") as member:
        data = member.read(limit + 1)
    if len(data) > limit or len(data) != info.file_size:
        return None
    return data


def epub_metadata(path: Path) -> dict:
    try:
        with zipfile.ZipFile(path) as archive:
            container_data = bounded_zip_member(
                archive, "META-INF/container.xml", MAX_EPUB_CONTAINER_XML_BYTES,
            )
            if container_data is None:
                return {}
            container = ET.fromstring(container_data)
            node = container.find(".//{urn:oasis:names:tc:opendocument:xmlns:container}rootfile")
            if node is None:
                return {}
            opf_path = safe_epub_member_name(node.attrib.get("full-path", ""))
            opf_data = bounded_zip_member(archive, opf_path, MAX_EPUB_PACKAGE_XML_BYTES)
            return parse_opf_bytes(opf_data) if opf_data is not None else {}
    except (OSError, RuntimeError, NotImplementedError, zipfile.BadZipFile, ET.ParseError):
        return {}


def sidecar_metadata(directory: Path) -> dict:
    opf = directory / "metadata.opf"
    try:
        if not opf.is_file() or opf.stat().st_size > MAX_EPUB_PACKAGE_XML_BYTES:
            return {}
        with opf.open("rb") as handle:
            data = handle.read(MAX_EPUB_PACKAGE_XML_BYTES + 1)
        return parse_opf_bytes(data) if len(data) <= MAX_EPUB_PACKAGE_XML_BYTES else {}
    except OSError:
        return {}


def clean_stem(value: str) -> str:
    result = re.sub(r"\s+-\s+[^-]{2,80}$", "", value)
    result = re.sub(r"\s*\(\d+\)$", "", result)
    result = re.sub(r"[_\s]+", " ", result).strip(" ._-")
    return result or "Untitled"


def stable_id(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8", "surrogateescape")).hexdigest()[:20]


def cover_image_info(data: bytes) -> tuple[str, int, int] | None:
    """Return a tightly scoped image type and dimensions without decoding pixels."""
    if len(data) >= 24 and data.startswith(b"\x89PNG\r\n\x1a\n"):
        if data[12:16] != b"IHDR" or struct.unpack(">I", data[8:12])[0] != 13:
            return None
        width, height = struct.unpack(">II", data[16:24])
        image_format = "png"
    elif len(data) >= 4 and data.startswith(b"\xff\xd8"):
        width = height = 0
        offset = 2
        start_of_frame = {0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF}
        while offset < len(data):
            if data[offset] != 0xFF:
                offset += 1
                continue
            while offset < len(data) and data[offset] == 0xFF:
                offset += 1
            if offset >= len(data):
                break
            marker = data[offset]
            offset += 1
            if marker in {0x01, 0xD8, 0xD9} or 0xD0 <= marker <= 0xD7:
                continue
            if offset + 2 > len(data):
                return None
            segment_length = struct.unpack(">H", data[offset:offset + 2])[0]
            if segment_length < 2 or offset + segment_length > len(data):
                return None
            if marker in start_of_frame:
                if segment_length < 7:
                    return None
                height, width = struct.unpack(">HH", data[offset + 3:offset + 7])
                break
            if marker == 0xDA:
                break
            offset += segment_length
        if width == 0 or height == 0:
            return None
        image_format = "jpeg"
    else:
        return None
    if width < 1 or height < 1:
        return None
    if width > MAX_COVER_DIMENSION or height > MAX_COVER_DIMENSION:
        return None
    if width * height > MAX_COVER_PIXELS:
        return None
    return image_format, width, height


def sanitized_cover_is_valid(path: Path) -> bool:
    try:
        if not path.is_file() or path.stat().st_size > MAX_COVER_CACHE_BYTES:
            return False
        info = cover_image_info(path.read_bytes())
        return bool(info and info[0] == "png" and info[1] <= COVER_WIDTH and info[2] <= COVER_HEIGHT)
    except OSError:
        return False


def sanitize_cover_bytes(data: bytes, book_id: str, source_mtime_ns: int = 0) -> str:
    """Decode untrusted cover bytes outside the shell and cache a bounded PNG."""
    if len(data) > MAX_COVER_SOURCE_BYTES:
        return ""
    info = cover_image_info(data)
    if info is None:
        return ""
    target = CACHE_DIR / "covers" / f"{book_id}.png"
    try:
        if (target.stat().st_mtime_ns >= source_mtime_ns and sanitized_cover_is_valid(target)):
            return str(target)
    except OSError:
        pass
    magick = shutil.which("magick")
    if not magick:
        return ""
    target.parent.mkdir(parents=True, exist_ok=True)
    nonce = f"{os.getpid()}-{secrets.token_hex(6)}"
    source = target.parent / f".{book_id}-{nonce}.{info[0]}"
    pending = target.parent / f".{book_id}-{nonce}.png"
    try:
        source.write_bytes(data)
        result = subprocess.run(
            [
                magick,
                "-limit", "memory", "64MiB",
                "-limit", "map", "64MiB",
                "-limit", "disk", "16MiB",
                "-limit", "thread", "1",
                "-limit", "time", "10",
                "-limit", "width", str(MAX_COVER_DIMENSION),
                "-limit", "height", str(MAX_COVER_DIMENSION),
                "-limit", "area", str(MAX_COVER_PIXELS),
                f"{info[0]}:{source}[0]",
                "-auto-orient",
                "-thumbnail", f"{COVER_WIDTH}x{COVER_HEIGHT}>",
                "-background", "none",
                "-gravity", "center",
                "-extent", f"{COVER_WIDTH}x{COVER_HEIGHT}",
                "-strip",
                f"png:{pending}",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=15,
            check=False,
        )
        if result.returncode != 0 or not sanitized_cover_is_valid(pending):
            return ""
        os.replace(pending, target)
        return str(target)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    finally:
        source.unlink(missing_ok=True)
        pending.unlink(missing_ok=True)


def safe_cover_from_epub(path: Path, book_id: str) -> str:
    try:
        with zipfile.ZipFile(path) as archive:
            container_data = bounded_zip_member(
                archive, "META-INF/container.xml", MAX_EPUB_CONTAINER_XML_BYTES,
            )
            if container_data is None:
                return ""
            container = ET.fromstring(container_data)
            node = container.find(".//{urn:oasis:names:tc:opendocument:xmlns:container}rootfile")
            opf_name = safe_epub_member_name(node.attrib.get("full-path", "")) if node is not None else ""
            opf_data = bounded_zip_member(archive, opf_name, MAX_EPUB_PACKAGE_XML_BYTES)
            if opf_data is None:
                return ""
            root = ET.fromstring(opf_data)
            cover_id = ""
            for meta in root.findall(".//{*}meta"):
                if meta.attrib.get("name", "").lower() == "cover":
                    cover_id = meta.attrib.get("content", "")
                    break
                if meta.attrib.get("property", "").lower() == "cover-image":
                    cover_id = meta.attrib.get("refines", "").lstrip("#")
                    break
            item = None
            for candidate in root.findall(".//{*}item"):
                props = candidate.attrib.get("properties", "").split()
                if candidate.attrib.get("id") == cover_id or "cover-image" in props:
                    item = candidate
                    break
            if item is None:
                return ""
            member = str((Path(opf_name).parent / item.attrib.get("href", "")).as_posix())
            if member.startswith("../") or member.startswith("/"):
                return ""
            data = bounded_zip_member(archive, member, MAX_COVER_SOURCE_BYTES)
            if data is None:
                return ""
            return sanitize_cover_bytes(data, book_id, path.stat().st_mtime_ns)
    except (OSError, RuntimeError, NotImplementedError, zipfile.BadZipFile, ET.ParseError):
        return ""


def safe_cover_from_sidecar(path: Path, book_id: str) -> str:
    try:
        stat = path.stat()
        if not path.is_file() or stat.st_size > MAX_COVER_SOURCE_BYTES:
            return ""
        data = path.read_bytes()
    except OSError:
        return ""
    return sanitize_cover_bytes(data, book_id, stat.st_mtime_ns)


def scan_library(force: bool = False) -> list[dict]:
    cfg = settings()
    root = Path(cfg["libraryFolder"])
    if not root.is_dir():
        return []
    cache = read_json(INDEX_FILE, {})
    if not isinstance(cache, dict):
        cache = {}
    records = cache.get("records", {}) if (
        cache.get("version") == INDEX_VERSION and cache.get("root") == str(root)
    ) else {}
    progress = read_json(PROGRESS_FILE, {})
    if not isinstance(progress, dict):
        progress = {}
    groups: dict[str, list[Path]] = {}
    count = 0
    for base, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in {"node_modules", "__pycache__"}]
        for name in files:
            suffix = Path(name).suffix.lower().lstrip(".")
            if suffix not in SUPPORTED:
                continue
            path = Path(base) / name
            try:
                relative_parent = path.parent.relative_to(root)
            except ValueError:
                continue
            group_key = str(relative_parent) if relative_parent != Path(".") else clean_stem(path.stem).casefold()
            groups.setdefault(group_key, []).append(path)
            count += 1
            if count >= 15000:
                break
        if count >= 15000:
            break
    books: list[dict] = []
    next_records: dict[str, dict] = {}
    for group_key, paths in groups.items():
        paths.sort(key=lambda p: (FORMAT_PRIORITY.index(p.suffix.lower().lstrip(".")), str(p))
                   if p.suffix.lower().lstrip(".") in FORMAT_PRIORITY else (999, str(p)))
        primary = paths[0]
        book_id = stable_id(str(root) + "\0" + group_key)
        signature_paths = list(paths)
        signature_paths.extend(p for p in (primary.parent / "metadata.opf", primary.parent / "cover.jpg") if p.is_file())
        signature = "|".join(f"{p}:{p.stat().st_mtime_ns}:{p.stat().st_size}" for p in signature_paths)
        cached = records.get(book_id, {}) if not force else {}
        if cached.get("signature") == signature:
            book = dict(cached.get("book", {}))
        else:
            metadata = sidecar_metadata(primary.parent)
            if not metadata and primary.suffix.lower() == ".epub":
                metadata = epub_metadata(primary)
            title = metadata.get("title") or clean_stem(primary.stem)
            authors = metadata.get("authors") or []
            if isinstance(authors, str):
                authors = [authors]
            cover_path = primary.parent / "cover.jpg"
            cover = safe_cover_from_sidecar(cover_path, book_id) if cover_path.is_file() else ""
            if not cover:
                epub_path = next((p for p in paths if p.suffix.lower() == ".epub"), None)
                if epub_path:
                    cover = safe_cover_from_epub(epub_path, book_id)
            book = {
                "id": book_id,
                "title": title,
                "authors": authors,
                "author": " & ".join(authors) if authors else "Unknown author",
                "path": str(primary),
                "format": primary.suffix.lower().lstrip("."),
                "formats": [p.suffix.lower().lstrip(".") for p in paths],
                "files": {p.suffix.lower().lstrip("."): str(p) for p in paths},
                "cover": cover,
                "language": metadata.get("language", ""),
                "description": metadata.get("description", ""),
                "added": datetime.fromtimestamp(primary.stat().st_mtime, timezone.utc).isoformat(),
            }
        state = progress.get("books", {}).get(book_id, {}) if isinstance(progress.get("books", {}), dict) else {}
        book["progress"] = max(0.0, min(1.0, float(state.get("percentage", 0) or 0)))
        book["lastOpened"] = str(state.get("lastOpened", ""))
        book["chapter"] = str(state.get("chapter", ""))
        books.append(book)
        next_records[book_id] = {"signature": signature, "book": {k: v for k, v in book.items() if k not in {"progress", "lastOpened", "chapter"}}}
    atomic_json(INDEX_FILE, {
        "version": INDEX_VERSION, "root": str(root), "generated": utc_now(), "records": next_records,
    })
    sorter = cfg["sort"]
    if sorter == "title":
        books.sort(key=lambda b: (b["title"].casefold(), b["author"].casefold()))
    elif sorter == "author":
        books.sort(key=lambda b: (b["author"].casefold(), b["title"].casefold()))
    elif sorter == "added":
        books.sort(key=lambda b: b["added"], reverse=True)
    else:
        books.sort(key=lambda b: (b["title"].casefold(), b["author"].casefold()))
        books.sort(key=lambda b: b["lastOpened"], reverse=True)
    return books


def progress_state() -> dict:
    value = read_json(PROGRESS_FILE, {"lastBookId": "", "books": {}})
    if not isinstance(value, dict):
        return {"lastBookId": "", "books": {}}
    value.setdefault("lastBookId", "")
    value.setdefault("books", {})
    return value


def update_progress(book_id: str, change: dict) -> dict:
    state = progress_state()
    books = state["books"]
    current = books.get(book_id, {}) if isinstance(books.get(book_id, {}), dict) else {}
    allowed = {"cfi", "percentage", "chapter", "bookmarks", "lastOpened"}
    current.update({k: v for k, v in change.items() if k in allowed})
    current["lastOpened"] = utc_now()
    current["percentage"] = max(0.0, min(1.0, float(current.get("percentage", 0) or 0)))
    if not isinstance(current.get("bookmarks", []), list):
        current["bookmarks"] = []
    books[book_id] = current
    state["lastBookId"] = book_id
    atomic_json(PROGRESS_FILE, state)
    return current


def library_payload(force: bool = False, query: str = "", limit: int = 0) -> dict:
    books = scan_library(force=force)
    if query:
        needle = query.casefold()
        books = [b for b in books if needle in f"{b['title']} {b['author']} {' '.join(b['formats'])}".casefold()]
    if limit > 0:
        books = books[:limit]
    state = progress_state()
    return {
        "ok": True,
        "books": books,
        "count": len(books),
        "lastBookId": state.get("lastBookId", ""),
        "settings": settings(),
        "starterLibrary": str(STARTER_LIBRARY_DIR),
        "converterAvailable": shutil.which("ebook-convert") is not None,
    }


def find_book(book_id: str) -> dict | None:
    return next((book for book in scan_library() if book["id"] == book_id), None)


def readable_file(book: dict) -> Path:
    files = book.get("files", {})
    if files.get("epub"):
        return Path(files["epub"])
    if files.get("pdf"):
        return Path(files["pdf"])
    source = Path(book["path"])
    fmt = source.suffix.lower().lstrip(".")
    if fmt not in CONVERTIBLE:
        raise RuntimeError(f"{fmt.upper()} reading is not available yet")
    converter = shutil.which("ebook-convert")
    if not converter:
        raise RuntimeError(f"{fmt.upper()} requires the optional Calibre converter (ebook-convert)")
    target = CACHE_DIR / "converted" / f"{book['id']}.epub"
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists() or target.stat().st_mtime < source.stat().st_mtime:
        temporary = target.with_suffix(".working.epub")
        result = subprocess.run([converter, str(source), str(temporary)], capture_output=True, text=True, timeout=300)
        if result.returncode != 0 or not temporary.is_file():
            temporary.unlink(missing_ok=True)
            detail = (result.stderr or result.stdout).strip().splitlines()
            raise RuntimeError(detail[-1] if detail else f"Could not convert {fmt.upper()}")
        os.replace(temporary, target)
    return target


def server_info() -> dict:
    value = read_json(SERVER_FILE, {})
    return value if isinstance(value, dict) else {}


def runtime_revision() -> str:
    paths = [Path(__file__).resolve(), WEB_DIR / "index.html", WEB_DIR / "app.css", WEB_DIR / "app.js",
             WEB_DIR / "vendor" / "epub.min.js", WEB_DIR / "vendor" / "jszip.min.js"]
    signature = []
    for path in paths:
        try:
            stat = path.stat()
            signature.append(f"{path.name}:{stat.st_mtime_ns}:{stat.st_size}")
        except OSError:
            signature.append(f"{path.name}:missing")
    return stable_id("|".join(signature))


def server_process_alive(info: dict | None = None) -> bool:
    info = info or server_info()
    pid = int(info.get("pid", 0) or 0)
    if pid <= 0:
        return False
    try:
        command = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        return b"serve" in command and any(Path(os.fsdecode(part)).name == "ebook-tool" for part in command if part)
    except OSError:
        return False


def server_alive(info: dict | None = None) -> bool:
    info = info or server_info()
    return (server_process_alive(info)
            and info.get("helper") == str(Path(__file__).resolve())
            and info.get("revision") == runtime_revision())


class ReaderHandler(BaseHTTPRequestHandler):
    server_version = "LeafReader/1.1"

    def log_message(self, fmt: str, *args: object) -> None:
        return

    def send_bytes(self, data: bytes, content_type: str, status: int = 200, cache: str = "no-store") -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", cache)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy", "default-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src blob: 'self'")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, value: object, status: int = 200) -> None:
        self.send_bytes(json.dumps(value, ensure_ascii=False).encode(), "application/json; charset=utf-8", status)

    def route(self) -> tuple[str, dict[str, list[str]]]:
        parsed = urllib.parse.urlsplit(self.path)
        return parsed.path, urllib.parse.parse_qs(parsed.query)

    def do_GET(self) -> None:
        route, query = self.route()
        if route == "/api/bootstrap":
            payload = library_payload(query=query.get("q", [""])[0])
            payload["token"] = self.server.token
            payload["progressState"] = progress_state()
            self.send_json(payload)
            return
        if route.startswith("/api/book/"):
            book_id = route.rsplit("/", 1)[-1]
            book = find_book(book_id)
            if not book:
                self.send_json({"ok": False, "error": "Book not found"}, 404)
                return
            try:
                path = readable_file(book)
                data = path.read_bytes()
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
                self.send_json({"ok": False, "error": str(exc)}, 422)
                return
            mime = "application/pdf" if path.suffix.lower() == ".pdf" else "application/epub+zip"
            self.send_bytes(data, mime, cache="private, max-age=3600")
            return
        if route.startswith("/api/cover/"):
            book = find_book(route.rsplit("/", 1)[-1])
            cover = Path(book["cover"]) if book and book.get("cover") else None
            if not cover or not cover.is_file():
                self.send_bytes(b"", "image/jpeg", 404)
                return
            mime = mimetypes.guess_type(cover.name)[0] or "image/jpeg"
            self.send_bytes(cover.read_bytes(), mime, cache="private, max-age=86400")
            return
        relative = "index.html" if route in {"/", "/reader"} else route.lstrip("/")
        target = (WEB_DIR / relative).resolve()
        try:
            target.relative_to(WEB_DIR.resolve())
        except ValueError:
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        if not target.is_file():
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        mime = mimetypes.guess_type(target.name)[0] or "application/octet-stream"
        self.send_bytes(target.read_bytes(), mime, cache="no-cache")

    def do_POST(self) -> None:
        if self.headers.get("X-Leaf-Token", "") != self.server.token:
            self.send_json({"ok": False, "error": "Invalid request token"}, 403)
            return
        try:
            length = min(int(self.headers.get("Content-Length", "0")), 1_000_000)
            payload = json.loads(self.rfile.read(length) or b"{}")
        except (ValueError, TypeError):
            self.send_json({"ok": False, "error": "Invalid JSON"}, 400)
            return
        route, _ = self.route()
        if route.startswith("/api/progress/"):
            book_id = route.rsplit("/", 1)[-1]
            if not find_book(book_id):
                self.send_json({"ok": False, "error": "Book not found"}, 404)
                return
            self.send_json({"ok": True, "progress": update_progress(book_id, payload)})
            return
        if route == "/api/settings":
            allowed = {"fontSize", "fontFamily", "lineHeight", "pageWidth", "theme", "flow", "pageTurn", "showClock", "sort"}
            self.send_json({"ok": True, "settings": save_settings({k: v for k, v in payload.items() if k in allowed})})
            return
        self.send_json({"ok": False, "error": "Not found"}, 404)


class ReaderServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, address: tuple[str, int], token: str):
        self.token = token
        super().__init__(address, ReaderHandler)


def serve(port: int = 0) -> int:
    token = secrets.token_urlsafe(24)
    server = ReaderServer(("127.0.0.1", port), token)
    atomic_json(SERVER_FILE, {"pid": os.getpid(), "port": server.server_port, "token": token,
                              "helper": str(Path(__file__).resolve()), "revision": runtime_revision(),
                              "started": utc_now()})
    try:
        server.serve_forever(poll_interval=0.4)
    finally:
        if server_info().get("pid") == os.getpid():
            SERVER_FILE.unlink(missing_ok=True)
    return 0


def start_server() -> dict:
    info = server_info()
    if server_alive(info):
        return {"ok": True, "url": f"http://127.0.0.1:{info.get('port', PORT)}/", "pid": info.get("pid")}
    if server_process_alive(info):
        try:
            os.kill(int(info["pid"]), 15)
            for _ in range(30):
                if not server_process_alive(info):
                    break
                time.sleep(0.05)
        except (OSError, ValueError, TypeError):
            pass
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "serve", "--port", "0"], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        time.sleep(0.05)
        info = server_info()
        if server_alive(info):
            return {"ok": True, "url": f"http://127.0.0.1:{info.get('port', PORT)}/", "pid": info.get("pid")}
    return {"ok": False, "error": "Reader service did not start"}


def activate_reader(pid: int) -> bool:
    """Focus and fullscreen the reader on Hyprland, with Qt as the fallback elsewhere."""
    hyprctl = shutil.which("hyprctl")
    if not hyprctl or not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return False
    selector = f"pid:{pid}"
    for _ in range(50):
        try:
            listed = subprocess.run([hyprctl, "clients", "-j"], capture_output=True, text=True, timeout=1)
            clients = json.loads(listed.stdout) if listed.returncode == 0 else []
            if any(int(client.get("pid", 0)) == pid for client in clients):
                # Let Qt finish its initial visibility negotiation before the
                # compositor applies the final state. Otherwise a late Qt
                # surface update can restore the window to the tiled layout.
                time.sleep(0.35)
                focused = fullscreen = None
                for _ in range(2):
                    focused = subprocess.run([
                        hyprctl, "dispatch", f'hl.dsp.focus({{ window = "{selector}" }})'
                    ], capture_output=True, text=True, timeout=1)
                    fullscreen = subprocess.run([
                        hyprctl, "dispatch",
                        f'hl.dsp.window.fullscreen({{ mode = "fullscreen", action = "set", window = "{selector}" }})'
                    ], capture_output=True, text=True, timeout=1)
                    time.sleep(0.15)
                return focused.returncode == 0 and fullscreen.returncode == 0
        except (OSError, subprocess.SubprocessError, ValueError, TypeError):
            return False
        time.sleep(0.04)
    return False


def reader_environment() -> dict[str, str]:
    """Keep WebEngine offline while preserving the user's existing Qt flags."""
    env = os.environ.copy()
    existing = env.get("QTWEBENGINE_CHROMIUM_FLAGS", "").strip()
    offline_flags = [
        "--proxy-server=http://127.0.0.1:9",
        "--disable-background-networking",
        "--no-pings",
    ]
    env["QTWEBENGINE_CHROMIUM_FLAGS"] = " ".join(filter(None, [existing, *offline_flags]))
    return env


def launch_reader(book_id: str = "") -> dict:
    payload = library_payload()
    books = payload["books"]
    wanted = book_id or str(payload.get("lastBookId", ""))
    if wanted and not any(book["id"] == wanted for book in books):
        return {"ok": False, "error": "Book not found"}
    if not wanted and books:
        wanted = books[0]["id"]
    if not wanted:
        return {"ok": False, "error": "No ebooks were found in the selected library folder"}
    server = start_server()
    if not server.get("ok"):
        return server
    runner = shutil.which("qml6") or str(Path("/usr/lib/qt6/bin/qml"))
    if not Path(runner).is_file():
        runner = shutil.which("qml") or ""
    if not runner:
        return {"ok": False, "error": "The Qt 6 QML runner is not installed"}
    url = str(server["url"]) + "?book=" + urllib.parse.quote(wanted)
    update_progress(wanted, {})
    previous = read_json(READER_FILE, {})
    if isinstance(previous, dict):
        previous_pid = int(previous.get("pid", 0) or 0)
        try:
            command_line = Path(f"/proc/{previous_pid}/cmdline").read_bytes().replace(b"\0", b" ")
            if b"ReaderApp.qml" in command_line:
                os.kill(previous_pid, 15)
                for _ in range(20):
                    time.sleep(0.05)
                    if not Path(f"/proc/{previous_pid}").exists():
                        break
        except (OSError, ValueError):
            pass
    process = subprocess.Popen([runner, str(PLUGIN_DIR / "ReaderApp.qml"), "--", f"--leaf-reader-url={url}"],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, start_new_session=True,
                               env=reader_environment())
    atomic_json(READER_FILE, {"pid": process.pid, "bookId": wanted, "url": url, "opened": utc_now()})
    activate_reader(process.pid)
    return {"ok": True, "pid": process.pid, "bookId": wanted, "url": url}


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Leaf Reader local helper")
    sub = result.add_subparsers(dest="command", required=True)
    lib = sub.add_parser("library")
    lib.add_argument("--refresh", action="store_true")
    lib.add_argument("--query", default="")
    lib.add_argument("--limit", type=int, default=0)
    sub.add_parser("start")
    served = sub.add_parser("serve")
    served.add_argument("--port", type=int, default=0)
    opened = sub.add_parser("open")
    opened.add_argument("book_id", nargs="?", default="")
    choose = sub.add_parser("choose-folder")
    choose.add_argument("--folder")
    config = sub.add_parser("settings")
    config.add_argument("--library-folder")
    config.add_argument("--font-size", type=int)
    config.add_argument("--font-family", choices=sorted(FONTS))
    config.add_argument("--line-height", type=float)
    config.add_argument("--page-width", type=int)
    config.add_argument("--theme", choices=sorted(THEMES))
    config.add_argument("--flow", choices=sorted(FLOWS))
    config.add_argument("--page-turn", choices=["true", "false"])
    config.add_argument("--sort", choices=["recent", "title", "author", "added"])
    config.add_argument("--show-clock", choices=["true", "false"])
    mark = sub.add_parser("mark-opened")
    mark.add_argument("book_id")
    sub.add_parser("doctor")
    return result


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if args.command == "serve":
        return serve(args.port)
    if args.command == "library":
        print(json.dumps(library_payload(args.refresh, args.query, args.limit), ensure_ascii=False))
        return 0
    if args.command == "start":
        print(json.dumps(start_server()))
        return 0
    if args.command == "open":
        result = launch_reader(args.book_id)
        print(json.dumps(result))
        return 0 if result.get("ok") else 1
    if args.command == "choose-folder":
        chosen = args.folder
        if not chosen:
            picker = shutil.which("zenity")
            if not picker:
                print(json.dumps({"ok": False, "error": "Folder picker is unavailable; enter the path manually."}))
                return 1
            run = subprocess.run([picker, "--file-selection", "--directory", "--title=Choose your ebook library"], capture_output=True, text=True)
            if run.returncode != 0:
                print(json.dumps({"ok": False, "cancelled": True}))
                return 0
            chosen = run.stdout.strip()
        folder = Path(os.path.expanduser(chosen)).resolve()
        if not folder.is_dir():
            print(json.dumps({"ok": False, "error": "That folder does not exist."}))
            return 1
        print(json.dumps({"ok": True, "settings": save_settings({"libraryFolder": str(folder)})}))
        return 0
    if args.command == "settings":
        changes = {}
        for key, dest in [("library_folder", "libraryFolder"), ("font_size", "fontSize"),
                          ("font_family", "fontFamily"), ("line_height", "lineHeight"),
                          ("page_width", "pageWidth"), ("theme", "theme"),
                          ("flow", "flow"), ("sort", "sort")]:
            value = getattr(args, key)
            if value is not None:
                changes[dest] = value
        if args.show_clock is not None:
            changes["showClock"] = args.show_clock == "true"
        if args.page_turn is not None:
            changes["pageTurn"] = args.page_turn == "true"
        if args.library_folder and not Path(os.path.expanduser(args.library_folder)).is_dir():
            print(json.dumps({"ok": False, "error": "That folder does not exist."}))
            return 1
        print(json.dumps({"ok": True, "settings": save_settings(changes)}))
        return 0
    if args.command == "mark-opened":
        if not find_book(args.book_id):
            print(json.dumps({"ok": False, "error": "Book not found"}))
            return 1
        print(json.dumps({"ok": True, "progress": update_progress(args.book_id, {})}))
        return 0
    if args.command == "doctor":
        cfg = settings()
        result = {
            "ok": WEB_DIR.is_dir() and (WEB_DIR / "vendor/epub.min.js").is_file(),
            "libraryFolder": cfg["libraryFolder"],
            "libraryExists": Path(cfg["libraryFolder"]).is_dir(),
            "starterLibrary": str(STARTER_LIBRARY_DIR),
            "starterBooks": len([path for path in STARTER_LIBRARY_DIR.glob("*.epub") if path.is_file()]),
            "books": len(scan_library()),
            "epubRenderer": (WEB_DIR / "vendor/epub.min.js").is_file(),
            "converter": shutil.which("ebook-convert") or "",
            "qtWebEngine": Path("/usr/lib/qt6/qml/QtWebEngine").is_dir(),
        }
        print(json.dumps(result, indent=2))
        return 0 if result["ok"] else 1
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
